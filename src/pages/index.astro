---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';
import Nav from '@/components/Nav.svelte';
import Hero from '@/components/Hero.svelte';
import Services from '@/components/Services.svelte';
import WhyUs from '@/components/WhyUs.svelte';
import Pricing from '@/components/Pricing.svelte';
import About from '@/components/About.svelte';
import Testimonials from '@/components/Testimonials.svelte';
import FAQ from '@/components/FAQ.svelte';
import Contact from '@/components/Contact.svelte';
import Footer from '@/components/Footer.svelte';
---

<Layout title={`${siteConfig.business.name} — ${siteConfig.business.tagline}`}>
  <Nav client:load />
  <Hero client:load />
  <Services client:visible />
  <WhyUs client:visible />
  <Pricing client:visible />
  <About client:visible />
  <Testimonials client:visible />
  <FAQ client:visible />
  <Contact client:visible />
  <Footer />
</Layout>
