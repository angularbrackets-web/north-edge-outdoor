# ──────────────────────────────────────────────
# Site Configuration
# ──────────────────────────────────────────────

# Public URL of the deployed site (used in astro.config.mjs and SEO)
SITE_URL=https://example.com

# ──────────────────────────────────────────────
# Supabase (required when features.enableSupabase = true)
# Settings → API in your Supabase dashboard
# ──────────────────────────────────────────────

PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ──────────────────────────────────────────────
# Resend (required when features.enableSupabase = true)
# API Keys in your Resend dashboard
# ──────────────────────────────────────────────

RESEND_API_KEY=re_...

# ──────────────────────────────────────────────
# Admin (required when features.enableAdmin = true)
# Email address that receives form submission notifications
# ──────────────────────────────────────────────

ADMIN_NOTIFICATION_EMAIL=hello@example.com
